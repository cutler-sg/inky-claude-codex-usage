[Unit]
Description=Fetch Claude and Codex usage directly through CLIProxyAPI
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/inky
EnvironmentFile=/etc/inky/usage.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/inky/.venv/bin/python -m inky_frame.poll
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/inky/state
